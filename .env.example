# ---------- 資料庫 ----------
# 完整 SQLAlchemy URL：<dialect+driver>://<user>:<password>@<host>:<port>/<db>
DB_URL=
# 額外傳給 create_engine 的參數（JSON），依驅動需要設定
DB_ENGINE_OPTIONS={}
SCHEMA_REF=ref
SCHEMA_HIST=ref_hist
SCHEMA_META=ref_meta
CREATE_DISPLAY_VIEWS=true
# IANA 時區名稱，依所在地調整
TIMEZONE=UTC

# ---------- Claude API ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
CLAUDE_FALLBACKS=true

# ---------- 通訊軟體應用 ----------
IM_API_BASE=
IM_CORP_ID=
IM_AGENT_ID=
IM_SECRET=
IM_TOKEN=
IM_AES_KEY=

# ---------- 行為 ----------
# 允許維護參照表的 userid（逗號分隔，空白=不限制）
ALLOWED_USERS=
SESSION_TTL_HOURS=24
MAX_ROWS_PER_CHANGE=5000
CSV_HEADER=display
EXPORT_DIR=exports
# /api/chat 等開發用 API；正式環境建議關閉或設定 token
DEV_API_ENABLED=false
DEV_API_TOKEN=
